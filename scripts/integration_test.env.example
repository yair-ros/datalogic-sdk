# Copy this file to scripts/integration_test.env and fill real values locally.
# The real file is gitignored.

DATALOGIC_CONFIRM_REAL_API_CALL=no

DATALOGIC_TOKEN=YOUR_TOKEN
DATALOGIC_ORDER_ID=999001
DATALOGIC_ORDER_NUMBER=TEST-999001

DATALOGIC_SHIPPING_STREET=DESTINATION_STREET
DATALOGIC_SHIPPING_CITY=DESTINATION_CITY
DATALOGIC_SHIPPING_FIRST_NAME=Test
DATALOGIC_SHIPPING_LAST_NAME=Customer
DATALOGIC_SHIPPING_HOUSE=10
DATALOGIC_SHIPPING_PHONE=0501234567

DATALOGIC_ORIGIN_CONTRACT=1234
DATALOGIC_ORIGIN_COMPANY_NAME=YOUR_COMPANY
DATALOGIC_ORIGIN_CITY=ORIGIN_CITY
DATALOGIC_ORIGIN_STREET=ORIGIN_STREET
DATALOGIC_ORIGIN_HOUSE=1
DATALOGIC_ORIGIN_PHONE=021234567
DATALOGIC_ORIGIN_EMAIL=ops@example.com

# Optional:
# DATALOGIC_SHIPPING_POSTCODE=6100000
# DATALOGIC_SHIPPING_APARTMENT=3
# DATALOGIC_SHIPPING_EMAIL=customer@example.com
# DATALOGIC_SHIPPING_COMPANY=Customer Company
# DATALOGIC_SHIPPING_ENTRANCE=B
# DATALOGIC_SHIPPING_FLOOR=4
# DATALOGIC_SHIPPING_N_CODE=PICKUP_LOCATION_ID
# DATALOGIC_ORDER_COMMENT=SDK test shipment
